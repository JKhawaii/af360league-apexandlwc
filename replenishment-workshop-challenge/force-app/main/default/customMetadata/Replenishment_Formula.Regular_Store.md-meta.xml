<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Regular Store</label>
    <protected>false</protected>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Covers lead-time demand and restores the standard safety-stock buffer.</value>
    </values>
    <values>
        <field>Formula__c</field>
        <value xsi:type="xsd:string">ROUND(MAX(SafetyStock + (AverageDailySales * LeadTimeDays) - CurrentStock, 0), 0)</value>
    </values>
    <values>
        <field>Is_Active__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Store_Type__c</field>
        <value xsi:type="xsd:string">Regular Store</value>
    </values>
</CustomMetadata>
